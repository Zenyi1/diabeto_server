# Copy to .env for local `vercel dev`. Never commit .env (see .gitignore).

# ---- Pipeline ----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.1
# Any OpenAI-compatible endpoint works here (OpenRouter, Groq, Vercel AI Gateway...).
OPENAI_BASE_URL=https://api.openai.com/v1
# Sent only when non-empty. Keep low: the client gives up at 90s.
OPENAI_REASONING_EFFORT=low
OPENAI_TIMEOUT_MS=60000
# Free, instant, no card: https://fdc.nal.usda.gov/api-key-signup
# Without it every food reports 0 carbs — see /health warnings.
USDA_API_KEY=
USDA_TIMEOUT_MS=4000

# Per-million-token rates for the model above, used to turn metered tokens into
# a spend figure on /usage. Left at 0 by default: a guessed price is worse than
# none. Current rates: https://openai.com/api/pricing
OPENAI_INPUT_USD_PER_MTOK=0
OPENAI_OUTPUT_USD_PER_MTOK=0

# ---- Identity ----
APPLE_BUNDLE_ID=com.zenyi.diabeto
# From the Apple Developer account. App Attest verifies <APPLE_TEAM_ID>.<APPLE_BUNDLE_ID>.
APPLE_TEAM_ID=
# openssl rand -base64 32
SESSION_SECRET=
# The client has no refresh flow, but handles 401 by signing out cleanly, so this
# can stay short. DELETE /account revokes outstanding tokens immediately.
SESSION_TTL_DAYS=60

# ---- Subscription ----
SUBSCRIPTION_PRODUCT_IDS=com.zenyi.diabeto.pro.monthly,com.zenyi.diabeto.pro.yearly
# sandbox while testing; production once live on the App Store.
APP_STORE_ENV=sandbox
# Numeric App Store app id. Required only when APP_STORE_ENV=production.
APP_STORE_APP_APPLE_ID=
# OCSP revocation checks on Apple's chain. Off by default: it adds a network round
# trip to every /analyze, and offline chain verification is what establishes trust.
APP_STORE_ONLINE_CHECKS=false

# ---- Gates (default on; a missing dependency fails closed, never open) ----
REQUIRE_ATTEST=true
REQUIRE_SUBSCRIPTION=true
# development accepts both aaguids (Xcode + TestFlight); production accepts only
# production. A gate that is on in a production deployment forces the matching
# environment here, or the server refuses to serve.
APP_ATTEST_ENV=development

# ---- Bootstrap: skips all three gates. Structurally ignored when
#      VERCEL_ENV=production, so forgetting to remove it cannot expose /analyze. ----
DEV_BYPASS_TOKEN=

# ---- Limits ----
RATE_LIMIT_PER_MIN=10
RATE_LIMIT_PER_DAY=50
MAX_IMAGE_BYTES=6291456
# Must stay under the client's 90s cutoff so the user sees a real error, not a URLError.
ANALYZE_DEADLINE_MS=78000

# ---- Storage ----
# The Vercel Upstash integration injects KV_REST_API_URL / KV_REST_API_TOKEN
# automatically. UPSTASH_REDIS_REST_URL / _TOKEN are accepted as alternatives.
KV_REST_API_URL=
KV_REST_API_TOKEN=
